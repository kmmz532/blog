{{- /* 管理画面（一括管理・編集・テンプレート・サムネイル）が読む索引。検索用の /index.json とは分ける。
  1 ファイル indexPageSize 件まで。2 つ目以降は /gh-admin/index/<n>.json */ -}}
{{- $size := int (site.Params.indexPageSize | default 50) -}}
{{- $v := now.Unix -}}
{{- $items := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
{{- $meta := partialCached "external-meta.html" . .File.Path -}}
{{- $items = $items | append (dict "slug" .File.ContentBaseName "title" $meta.title "url" (partial "post-url.html" .) "external" (.Params.external | default "") "date" (.Date.Format "2006-01-02") "images" $meta.images "tags" .Params.tags "categories" .Params.categories) -}}
{{- end -}}
{{- $total := len $items -}}
{{- $pages := div (add $total (sub $size 1)) $size -}}
{{- range $p := seq $pages -}}
  {{- $next := index (dict) "none" -}}
  {{- if lt $p $pages -}}{{- $next = printf "%s?v=%d" (relURL (printf "gh-admin/index/%d.json" (add $p 1))) $v -}}{{- end -}}
  {{- if gt $p 1 -}}
    {{- $chunk := first $size (after (mul (sub $p 1) $size) $items) -}}
    {{- $_ := (resources.FromString (printf "gh-admin/index/%d.json" $p) (dict "items" $chunk "next" $next "total" $total | jsonify)).Publish -}}
  {{- end -}}
{{- end -}}
{{- $next1 := index (dict) "none" -}}
{{- if gt $pages 1 -}}{{- $next1 = printf "%s?v=%d" (relURL "gh-admin/index/2.json") $v -}}{{- end -}}
{{- dict "items" (first $size $items) "next" $next1 "total" $total | jsonify -}}
