{{- $items := first 30 (where site.RegularPages "Section" "posts") -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title | transform.XMLEscape }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>{{ site.Params.description | transform.XMLEscape }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    <atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range $items }}
    <item>
      <title>{{ (partialCached "external-meta.html" . .File.Path | transform.Unmarshal).title | transform.XMLEscape }}</title>
      <link>{{ partial "post-url.html" . }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ partial "post-url.html" . }}</guid>
      <description>{{ (partialCached "external-meta.html" . .File.Path | transform.Unmarshal).summary | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
