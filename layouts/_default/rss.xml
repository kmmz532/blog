{{- /* 先頭の XML 宣言は、HTML として読まれてエスケープされないように safeHTML で出す */ -}}
{{ `<?xml version="1.0" encoding="utf-8" standalone="yes"?>` | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
{{- $items := first 30 (where site.RegularPages "Section" "posts") -}}
  <channel>
    <title>{{ site.Title | transform.XMLEscape }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>{{ site.Params.description | transform.XMLEscape }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    <atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range $items }}
    {{- $url := or .Params.external .Permalink }}
    <item>
      <title>{{ (partialCached "external-meta.html" . .File.Path).title | transform.XMLEscape }}</title>
      <link>{{ $url }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ $url }}</guid>
      <description>{{ (partialCached "external-meta.html" . .File.Path).summary | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
